# Copy this file to .env for local development. Never commit .env or real credentials.
# PocketHost / PocketBase BaaS Configuration (used by scripts/pb-migrate.ts)
# If PB_ADMIN_EMAIL exists in your shell env, use it. Otherwise, set here or leave empty.
POCKETBASE_URL=${POCKETBASE_URL:-https://web-chess.pockethost.io}
POCKETBASE_SUPERUSER_EMAIL=${PB_ADMIN_EMAIL:-${POCKETBASE_SUPERUSER_EMAIL:-}}
POCKETBASE_SUPERUSER_PASSWORD=${PB_ADMIN_PASSWORD:-${POCKETBASE_SUPERUSER_PASSWORD:-}}

# Local Server Configuration (used by src/server/index.ts)
PORT=${PORT:-3001}
HOST=${HOST:-0.0.0.0}
